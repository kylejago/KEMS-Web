#!/usr/bin/env bash
set -euo pipefail

[[ ${EUID:-$(id -u)} -eq 0 ]] || { echo "Run with sudo." >&2; exit 1; }
REPO="${KEMS_GITHUB_REPO:-$(cat /usr/local/lib/kems-web/github-repo 2>/dev/null || echo kylejago/KEMS-Web)}"
BASE=/opt/kems-web
RELEASES="$BASE/releases"
CURRENT="$BASE/current"
LIB=/usr/local/lib/kems-web
REMOTE_HELPER_URL="http://127.0.0.1:4175/health"
TMP="$(mktemp -d /tmp/kems-update.XXXXXX)"
trap 'rm -rf "$TMP"' EXIT

CURRENT_VERSION=""
[[ -f "$CURRENT/package.json" ]] && CURRENT_VERSION="$(node -e 'const p=require(process.argv[1]);process.stdout.write(String(p.version||""))' "$CURRENT/package.json")"
TARGET_VERSION="${1:-}"

echo "Checking GitHub for KEMS Web releases..."
curl -fsSL --retry 4 -H 'Accept: application/vnd.github+json' -H 'User-Agent: KEMS-Web-Updater' \
  "https://api.github.com/repos/${REPO}/releases?per_page=30" -o "$TMP/releases.json"

node - "$TMP/releases.json" "$TMP/selection.env" "$TARGET_VERSION" <<'NODE'
const fs = require('node:fs');
const [source, output, requested] = process.argv.slice(2);
const releases = JSON.parse(fs.readFileSync(source, 'utf8'));
const archiveFor = (release) => Array.isArray(release.assets) ? release.assets.find((asset) => /^kems-web-.+-pi\.tar\.gz$/.test(asset.name)) : null;
const versionFor = (archive) => archive?.name?.replace(/^kems-web-/, '').replace(/-pi\.tar\.gz$/, '') || '';
const selected = releases.find((release) => {
  if (release.draft) return false;
  const archive = archiveFor(release);
  if (!archive) return false;
  if (!requested) return true;
  const clean = String(requested).replace(/^v(?=\d)/, '');
  return versionFor(archive) === clean || String(release.tag_name || '') === requested || String(release.tag_name || '').replace(/^v(?=\d)/, '') === clean;
});
if (!selected) {
  console.error(requested ? `No KEMS Web Pi release matches exact target ${requested}.` : 'No KEMS Web Pi release was found.');
  process.exit(2);
}
const archive = archiveFor(selected);
const checksum = selected.assets.find((asset) => asset.name === `${archive.name}.sha256`);
const lines = [
  `TAG=${JSON.stringify(selected.tag_name)}`,
  `ARCHIVE_NAME=${JSON.stringify(archive.name)}`,
  `ARCHIVE_URL=${JSON.stringify(archive.browser_download_url)}`,
  `CHECKSUM_URL=${JSON.stringify(checksum?.browser_download_url || '')}`
];
fs.writeFileSync(output, lines.join('\n') + '\n');
NODE
source "$TMP/selection.env"

echo "Downloading release ${TAG}..."
curl -fsSL --retry 4 -L "$ARCHIVE_URL" -o "$TMP/$ARCHIVE_NAME"
if [[ -n "$CHECKSUM_URL" ]]; then
  echo "Verifying release checksum..."
  curl -fsSL --retry 4 -L "$CHECKSUM_URL" -o "$TMP/$ARCHIVE_NAME.sha256"
  (cd "$TMP" && sha256sum -c "$ARCHIVE_NAME.sha256")
else
  echo "Release is missing its SHA-256 asset; refusing update." >&2
  exit 3
fi

echo "Preparing KEMS Web release..."
tar -xzf "$TMP/$ARCHIVE_NAME" -C "$TMP"
ROOT="$(find "$TMP" -mindepth 1 -maxdepth 2 -type f -name package.json -printf '%h\n' | head -n1)"
[[ -n "$ROOT" && -f "$ROOT/server.mjs" ]] || { echo "Invalid KEMS Web release archive." >&2; exit 4; }
VERSION="$(node -e 'const p=require(process.argv[1]);process.stdout.write(String(p.version||""))' "$ROOT/package.json")"
[[ -n "$VERSION" ]] || { echo "Release has no package version." >&2; exit 5; }

SAME_VERSION=0
if [[ "$VERSION" == "$CURRENT_VERSION" ]]; then
  SAME_VERSION=1
  echo "KEMS Web ${VERSION} is already installed; refreshing appliance helpers."
else
  DEST="$RELEASES/$VERSION"
  rm -rf "$DEST"
  cp -a "$ROOT" "$DEST"
  rm -rf "$DEST/data"
  mkdir -p "$DEST/data"
  [[ -f "$DEST/gateway.mjs" ]] && node --check "$DEST/gateway.mjs"
  node --check "$DEST/server.mjs"
  node --check "$DEST/public/app.js"
  if [[ -f "$DEST/scripts/smoke-test.mjs" ]]; then
    (cd "$DEST" && node scripts/smoke-test.mjs >/dev/null)
  fi

  PREVIOUS="$(readlink -f "$CURRENT" 2>/dev/null || true)"
  echo "Switching active release to ${VERSION}..."
  ln -sfn "$DEST" "$BASE/current.new"
  mv -Tf "$BASE/current.new" "$CURRENT"
  echo "Restarting KEMS Web..."
  systemctl restart kems-web.service

  echo "Waiting for KEMS Web health check..."
  OK=0
  for _ in $(seq 1 30); do
    if node "$LIB/healthcheck.mjs" http://127.0.0.1:4173/api/health >/dev/null 2>&1; then OK=1; break; fi
    sleep 1
  done
  if [[ "$OK" != 1 ]]; then
    echo "KEMS Web ${VERSION} failed its health check." >&2
    if [[ -n "$PREVIOUS" && -d "$PREVIOUS" ]]; then
      echo "Rolling back automatically..."
      ln -sfn "$PREVIOUS" "$BASE/current.rollback"
      mv -Tf "$BASE/current.rollback" "$CURRENT"
      systemctl restart kems-web.service
    fi
    exit 6
  fi

  sha256sum "$TMP/$ARCHIVE_NAME" > "$DEST/INSTALLED_SHA256"
  echo "Updated KEMS Web: ${CURRENT_VERSION:-none} -> ${VERSION} (${TAG})"
fi

# Always refresh appliance helpers and service definitions from the verified
# release. Web.17 uses this path as a one-time bootstrap repair for Pis that
# reached Web.16 using the Web.15 updater before the dedicated Remote Access
# helper service existed on the appliance.
if [[ -d "$ROOT/deploy" ]]; then
  if [[ -f "$ROOT/deploy/bin/kems-update" ]]; then install -m 0755 "$ROOT/deploy/bin/kems-update" /usr/local/sbin/kems-update.new && mv -f /usr/local/sbin/kems-update.new /usr/local/sbin/kems-update; fi
  if [[ -f "$ROOT/deploy/bin/kems-rollback" ]]; then install -m 0755 "$ROOT/deploy/bin/kems-rollback" /usr/local/sbin/kems-rollback.new && mv -f /usr/local/sbin/kems-rollback.new /usr/local/sbin/kems-rollback; fi
  if [[ -f "$ROOT/deploy/bin/kems-status" ]]; then install -m 0755 "$ROOT/deploy/bin/kems-status" /usr/local/sbin/kems-status.new && mv -f /usr/local/sbin/kems-status.new /usr/local/sbin/kems-status; fi
  [[ -f "$ROOT/deploy/healthcheck.mjs" ]] && install -m 0644 "$ROOT/deploy/healthcheck.mjs" "$LIB/healthcheck.mjs"
  [[ -f "$ROOT/deploy/manager.mjs" ]] && install -m 0644 "$ROOT/deploy/manager.mjs" "$LIB/manager.mjs"
  [[ -f "$ROOT/deploy/bundle-agent.mjs" ]] && install -m 0644 "$ROOT/deploy/bundle-agent.mjs" "$LIB/bundle-agent.mjs"
  [[ -f "$ROOT/deploy/remote-access-service.mjs" ]] && install -m 0644 "$ROOT/deploy/remote-access-service.mjs" "$LIB/remote-access-service.mjs"
  [[ -f "$ROOT/deploy/systemd/kems-web.service" ]] && install -m 0644 "$ROOT/deploy/systemd/kems-web.service" /etc/systemd/system/kems-web.service
  [[ -f "$ROOT/deploy/systemd/kems-web-manager.service" ]] && install -m 0644 "$ROOT/deploy/systemd/kems-web-manager.service" /etc/systemd/system/kems-web-manager.service
  [[ -f "$ROOT/deploy/systemd/kems-web-bundle-agent.service" ]] && install -m 0644 "$ROOT/deploy/systemd/kems-web-bundle-agent.service" /etc/systemd/system/kems-web-bundle-agent.service
  [[ -f "$ROOT/deploy/systemd/kems-web-remote-access.service" ]] && install -m 0644 "$ROOT/deploy/systemd/kems-web-remote-access.service" /etc/systemd/system/kems-web-remote-access.service
  mkdir -p /var/lib/kems-web-management
  chown root:kemsweb /var/lib/kems-web-management 2>/dev/null || true
  chmod 750 /var/lib/kems-web-management 2>/dev/null || true
  systemctl daemon-reload
  systemctl enable kems-web-manager.service >/dev/null 2>&1 || true
  systemctl is-active --quiet kems-web-manager.service || systemctl start kems-web-manager.service || true
  if [[ -f /etc/systemd/system/kems-web-bundle-agent.service && -f "$LIB/bundle-agent.mjs" ]]; then
    systemctl enable kems-web-bundle-agent.service >/dev/null 2>&1 || true
    systemctl is-active --quiet kems-web-bundle-agent.service || systemctl start kems-web-bundle-agent.service || true
  fi
  if [[ -f /etc/systemd/system/kems-web-remote-access.service && -f "$LIB/remote-access-service.mjs" ]]; then
    echo "Activating KEMS Remote Access setup helper..."
    systemctl enable kems-web-remote-access.service >/dev/null 2>&1 || true
    systemctl restart kems-web-remote-access.service

    HELPER_OK=0
    for _ in $(seq 1 20); do
      if curl -fsS --max-time 2 "$REMOTE_HELPER_URL" >/dev/null 2>&1; then HELPER_OK=1; break; fi
      sleep 1
    done
    if [[ "$HELPER_OK" != 1 ]]; then
      systemctl --no-pager --full status kems-web-remote-access.service || true
      journalctl -u kems-web-remote-access.service -n 40 --no-pager || true
      echo "KEMS Remote Access setup helper failed its loopback health check." >&2
      exit 8
    fi
    echo "KEMS Remote Access setup helper is healthy."
  fi

  # Apply a changed web service definition immediately. The public property
  # service remains on port 4173 while its application backend and privileged
  # Remote Access setup helper stay on loopback-only ports.
  systemctl restart kems-web.service
  OK=0
  for _ in $(seq 1 30); do
    if node "$LIB/healthcheck.mjs" http://127.0.0.1:4173/api/health >/dev/null 2>&1; then OK=1; break; fi
    sleep 1
  done
  [[ "$OK" == 1 ]] || { echo "KEMS Web failed its post-helper-refresh health check." >&2; exit 7; }

  # The updater may itself be running as a child of the manager. Schedule the
  # manager refresh after this command exits rather than killing its own cgroup.
  if command -v systemd-run >/dev/null 2>&1; then
    systemd-run --on-active=3s --collect /bin/systemctl restart kems-web-manager.service >/dev/null 2>&1 || true
  fi
fi

if [[ "$SAME_VERSION" == 1 ]]; then
  echo "Refreshed KEMS Web ${VERSION} appliance helpers and service definitions."
fi

ACTIVE="$(readlink -f "$CURRENT")"
mapfile -t OLD < <(find "$RELEASES" -mindepth 1 -maxdepth 1 -type d -printf '%T@ %p\n' | sort -nr | awk '{print $2}' | tail -n +4)
for item in "${OLD[@]:-}"; do
  [[ -n "$item" && "$item" != "$ACTIVE" ]] && rm -rf "$item"
done
