# Optional server settings. Home Assistant connection details are entered in the website.
HOST=0.0.0.0
PORT=4173
POLL_INTERVAL_MS=8000
TZ=Europe/London
DATA_DIR=./data

# Optional: set a private passphrase to derive the local credential-encryption key.
# When omitted, KEMS creates a random key in the data folder.
# KEMS_CONFIG_KEY=replace-with-a-long-random-passphrase
